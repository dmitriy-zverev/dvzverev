{
  "version": 1,
  "service": {
    "alertChatIdEnv": "BOT_ALERT_CHAT_ID",
    "minDestinationIntervalMinutes": 30,
    "reports": {
      "timezone": "Europe/Moscow",
      "eveningStartsAt": "16:00",
      "beforeReportLeadMinutes": 5,
      "batchDeadlineMinutes": 45,
      "reportEmptyBatches": true,
      "mode": "owner",
      "publicSiteUrl": "https://dvzverev.ru",
      "testChatIdEnv": "BOT_REPORT_TEST_CHAT_ID",
      "alertChatIdEnv": "BOT_ALERT_CHAT_ID"
    }
  },
  "providers": {
    "budget-editor": {
      "adapter": "openrouter",
      "credentialEnv": "OPENROUTER_API_KEY",
      "model": "deepseek/deepseek-v4.1-flash-1017",
      "fallbackModels": ["openai/gpt-6-luna", "z-ai/glm-5.3-flash"]
    },
    "lifestyle-editor": {
      "adapter": "openrouter",
      "credentialEnv": "OPENROUTER_API_KEY",
      "model": "deepseek/deepseek-v4.1-flash-1017",
      "fallbackModels": ["openai/gpt-6-luna", "z-ai/glm-5.3-flash"]
    }
  },
  "destinations": {
    "connaissance-vk": {
      "platform": "vk",
      "groupIdEnv": "VK_DARK_ACADEMIA_GROUP_ID",
      "credentialEnv": "VK_DARK_ACADEMIA_ACCESS_TOKEN",
      "media": {
        "enabled": true,
        "kind": "image",
        "prompt": "prompts/dark-academia-image.md",
        "model": "openai/gpt-image-2.5-sunburst",
        "fallbackModels": ["google/gemini-3.1-flash-lite-image", "meta/muse-image"],
        "maxAttempts": 1,
        "uploadMode": "photo",
        "photosCredentialEnv": "VK_PHOTOS_ACCESS_TOKEN",
        "scheduling": "vk-weekly"
      }
    },
    "code-to-think-vk": {
      "platform": "vk",
      "groupIdEnv": "VK_CODE_TO_THINK_GROUP_ID",
      "credentialEnv": "VK_ACCESS_TOKEN",
      "albumIdEnv": "VK_CODE_TO_THINK_ALBUM_ID",
      "media": {
        "enabled": true,
        "kind": "image",
        "prompt": "prompts/code-to-think-image.md",
        "model": "openai/gpt-image-2.5-sunburst",
        "fallbackModels": ["google/gemini-3.1-flash-lite-image", "meta/muse-image"],
        "maxAttempts": 1,
        "uploadMode": "photo",
        "photosCredentialEnv": "VK_PHOTOS_ACCESS_TOKEN",
        "scheduling": "vk-weekly"
      }
    },
    "things-vk": {
      "platform": "vk",
      "groupIdEnv": "VK_THINGS_GROUP_ID",
      "credentialEnv": "VK_THINGS_ACCESS_TOKEN",
      "media": {
        "enabled": true,
        "kind": "image",
        "prompt": "prompts/things-image.md",
        "model": "openai/gpt-image-2.5-sunburst",
        "fallbackModels": ["google/gemini-3.1-flash-lite-image", "meta/muse-image"],
        "maxAttempts": 1,
        "uploadMode": "photo",
        "photosCredentialEnv": "VK_PHOTOS_ACCESS_TOKEN",
        "scheduling": "vk-weekly"
      }
    }
  },
  "projects": {
    "dark-academia": {
      "enabled": true,
      "format": "literary",
      "language": "ru",
      "postSource": "openrouter",
      "prompts": {
        "editor": "prompts/dark-academia.md",
        "cover": "prompts/dark-academia-image.md"
      },
      "generation": {
        "provider": "budget-editor"
      },
      "schedule": {
        "timezone": "Europe/Moscow",
        "times": ["10:00", "18:00"],
        "missedSlots": "skip"
      },
      "delivery": {
        "policy": "ordered-independent",
        "destinations": ["connaissance-vk"]
      },
      "budget": {
        "dailyUsd": 2,
        "monthlyUsd": 30
      },
      "statePath": "data/projects/dark-academia/state.json",
      "queuePath": "content/posts.json",
      "metrics": {
        "enabled": true,
        "intervalMinutes": 60
      }
    },
    "code-to-think": {
      "enabled": true,
      "format": "programming",
      "language": "ru",
      "postSource": "openrouter",
      "prompts": {
        "editor": "prompts/code-to-think.md",
        "cover": "prompts/code-to-think-image.md"
      },
      "generation": {
        "provider": "budget-editor",
        "reviewModel": "openai/gpt-6-luna"
      },
      "schedule": {
        "timezone": "Europe/Moscow",
        "times": ["12:00", "18:00"],
        "weekly": {
          "1": ["12:00", "18:00"],
          "2": ["12:00"],
          "3": ["12:00", "18:00"],
          "4": ["12:00"],
          "5": ["12:00", "18:00"],
          "6": ["12:00"],
          "7": ["12:00", "18:00"]
        },
        "missedSlots": "skip"
      },
      "delivery": {
        "policy": "ordered-independent",
        "destinations": ["code-to-think-vk"]
      },
      "statePath": "data/projects/code-to-think/state.json",
      "queuePath": "content/posts.json",
      "metrics": {
        "enabled": true,
        "intervalMinutes": 60
      }
    },
    "things": {
      "enabled": true,
      "format": "lifestyle",
      "language": "ru",
      "postSource": "openrouter",
      "prompts": {
        "editor": "prompts/things-editor.md",
        "cover": "prompts/things-image.md"
      },
      "generation": {
        "provider": "lifestyle-editor",
        "reviewModel": "openai/gpt-6-luna"
      },
      "schedule": {
        "timezone": "Europe/Moscow",
        "times": ["10:00", "18:00"],
        "missedSlots": "skip"
      },
      "delivery": {
        "policy": "ordered-independent",
        "destinations": ["things-vk"]
      },
      "statePath": "data/projects/things/state.json",
      "queuePath": "content/posts.json",
      "metrics": {
        "enabled": true,
        "intervalMinutes": 60
      }
    }
  }
}
