# Append to cabinet environment; never copy live tokens into this file.
VK_OAUTH_ENABLED=false
# ID from VK ID authorization cabinet, not a Mini App ID.
VK_OAUTH_CLIENT_ID=54809454
# Optional isolated PKCE experiment; never replaces the primary connection.
VK_OAUTH_TRIAL_CLIENT_ID=
VK_WEEKLY_OAUTH_ENABLED=false
VK_WEEKLY_CLIENT_ID=54809454
VK_OAUTH_REDIRECT_URI=https://www.dvzverev.ru/vk/callback/
# Requested scopes are candidates, not a guarantee of app access.
VK_OAUTH_SCOPES=wall photos groups video
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VK_OAUTH_ENCRYPTION_KEY=
VK_OAUTH_STORE_PATH=/app/data/vk-oauth.sqlite
VK_OAUTH_MEDIA_DIR=/app/content/oauth
VK_OAUTH_ALLOWED_USER_ID=
BOT_CABINET_MEMORY_LIMIT=256m
