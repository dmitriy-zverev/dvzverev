# Multi-project runtime: editorial settings live in service.json and prompts/*.md.
BOT_CONFIG_PATH=bot/service.json
BOT_STATE_PATH=bot/data/state.json
OPENROUTER_API_KEY=
OZON_IMAGE_MODEL=openai/gpt-image-1

# Telegram operational alerts.
TELEGRAM_BOT_TOKEN=
BOT_ALERT_CHAT_ID=

# Community tokens only; VK_ACCESS_TOKEN belongs to code-to-think.
VK_ACCESS_TOKEN=
VK_CODE_TO_THINK_GROUP_ID=242034586
# https://vk.ru/kod_na_podumat?z=album-242034586_313621887
VK_CODE_TO_THINK_ALBUM_ID=313621887
VK_DARK_ACADEMIA_ACCESS_TOKEN=
VK_DARK_ACADEMIA_GROUP_ID=194579254
VK_THINGS_ACCESS_TOKEN=
VK_THINGS_GROUP_ID=242058626

# Local cabinet; production uses BOT_CABINET_PASSWORD_HASH instead of plaintext.
BOT_CABINET_ENABLED=true
BOT_CABINET_DB_PATH=bot/data/cabinet.sqlite
BOT_CABINET_PORT=8787
BOT_CABINET_PASSWORD=
BOT_CABINET_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# BOT_CABINET_PASSWORD_HASH=
# BOT_CABINET_SECURE_COOKIES=true

# Production compose only. Keep the Redis password and URL consistent.
# BOT_IMAGE=dvzverev-poster:<deployed-tag>
# BOT_REDIS_PASSWORD=<random-secret>
# BOT_REDIS_URL=redis://:<url-encoded-random-secret>@redis:6379
# NODE_USE_ENV_PROXY=1
# HTTP_PROXY=http://<latvia-vps>:3129
# HTTPS_PROXY=http://<latvia-vps>:3129
# NO_PROXY=localhost,127.0.0.1,redis,api.vk.com,api.vk.ru,.vk.com,.vk.ru,.userapi.com,.vkuserphoto.ru,.vkuserphoto.net,.vkuser.net,.vk-cdn.net,.vkvideo.ru
# Latvia proxy is only for OpenRouter and Telegram. Keep VK in NO_PROXY (direct from Cloud.ru).
# Production origins: https://www.dvzverev.ru,https://dvzverev.ru
# Local development uses VPN; leave proxy variables unset.

# Weekly posts: always community tokens (text + GIF docs).
# Owner OAuth (path B): server PKCE for scope check / future photo upload.
# Enable on prod with redirect URI + encryption key; posts stay on community until switched.
VK_WEEKLY_OAUTH_ENABLED=false
VK_WEEKLY_CLIENT_ID=54809454
# VK_OAUTH_REDIRECT_URI=https://www.dvzverev.ru/vk/callback/
# VK_OAUTH_ENCRYPTION_KEY=
# VK_OAUTH_ALLOWED_USER_ID=
# VK_OAUTH_STORE_PATH=bot/data/vk-oauth.sqlite
# Legacy blank.html user tokens; IP-bound, not for Cloud.ru server.
VK_LEGACY_OAUTH_ENABLED=false
VK_LEGACY_CLIENT_ID=54809516
VK_LEGACY_REDIRECT_URI=https://oauth.vk.com/blank.html
