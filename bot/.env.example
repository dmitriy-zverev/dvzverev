TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENROUTER_API_KEY=
BOT_POST_SOURCE=queue
BOT_CONTENT_MODE=tip
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
BOT_IMAGES_ENABLED=false
OPENROUTER_IMAGE_MODEL=inclusionai/ming-image-0.1-design
BOT_PROMPT=Напиши мне пост про вайбкодинг на 500 символов в нужном нам формате.
BOT_ALERT_CHAT_ID=
VK_ACCESS_TOKEN=
VK_IMAGES_ENABLED=true
VK_PHOTOS_ACCESS_TOKEN=
# User token for VK wall photos (also written to bot/data/vk-photos.token after OAuth in Telegram).
VK_OAUTH_CLIENT_ID=
# Telegram user id of the operator who may paste oauth.vk.ru/blank.html#access_token=...
BOT_OPERATOR_USER_ID=
# Optional: path to .env for auto-update after token import (default bot/.env).
# BOT_ENV_FILE=bot/.env
VK_GROUP_ID=
BOT_TIMES=10:00
BOT_TIMEZONE=Europe/Moscow
BOT_QUEUE_PATH=bot/content/posts.json
BOT_STATE_PATH=bot/data/state.json
# Optional multi-project service config (see bot/service.example.json).
# BOT_CONFIG_PATH=bot/service.example.json

# Editorial cabinet (local): SQLite mirror + API on 127.0.0.1:8787
# BOT_CABINET_ENABLED=true
# BOT_CABINET_DB_PATH=bot/data/cabinet.sqlite
# BOT_CABINET_PASSWORD=change-me
# BOT_CABINET_PORT=8787
# BOT_CABINET_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# BOT_CABINET_SECURE_COOKIES=false
# Brute-force limits (per client IP, in-memory in cabinet API process)
# BOT_CABINET_LOGIN_MAX_ATTEMPTS=5
# BOT_CABINET_LOGIN_WINDOW_SEC=900
# BOT_CABINET_LOGIN_LOCKOUT_SEC=900
# Redis schedule (production compose): shared password, URL includes auth
# BOT_REDIS_PASSWORD=generate-a-long-random-secret
# BOT_REDIS_URL=redis://:generate-a-long-random-secret@redis:6379
# Локально задайте PUBLIC_BOT_API_BASE=http://127.0.0.1:8787 в .env.development; без переменной UI ходит на origin страницы (prod: same-origin до D6 proxy).
