---
import '../content/validate';
import '../styles/global.css';
import { site } from '../content/site';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.canonicalBase).href;

const personJsonLd = {
  '@type': 'Person',
  name: site.fullName,
  jobTitle: 'Product Engineer',
  url: site.canonicalBase,
  sameAs: [site.githubUrl, site.telegramUrl],
};

const serviceJsonLd = {
  '@type': 'ProfessionalService',
  name: site.fullName,
  url: site.canonicalBase,
  description: site.description,
  areaServed: 'RU',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [personJsonLd, serviceJsonLd],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href="/fonts/DVZMonoNerd-ExtraBold-v1.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
