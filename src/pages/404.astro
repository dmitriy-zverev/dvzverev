---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена — Дмитрий Зверев">
  <section class="section section-panel">
    <div class="container">
      <p class="section-label">error / 404.lua</p>
      <h1 class="section-title">Страница<br />не найдена.</h1>
      <p class="mono not-found-note">-- buffer does not exist</p>
      <div class="not-found-action">
        <a class="button button-primary" href="/">:главная</a>
      </div>
    </div>
  </section>
</BaseLayout>
