---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

interface Props {
  title?: string;
}

const { title = 'Редакционный кабинет' } = Astro.props;
const apiBase = import.meta.env.PUBLIC_BOT_API_BASE ?? '';
const assetVersion = (file: string) =>
  createHash('sha256').update(readFileSync(`public/bot/${file}`)).digest('hex').slice(0, 12);
const cssUrl = `/bot/dashboard.css?v=${assetVersion('dashboard.css')}`;
const jsUrl = `/bot/dashboard.js?v=${assetVersion('dashboard.js')}`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3f5f8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="stylesheet" href={cssUrl} />
  </head>
  <body>
    <div id="app" class="cabinet" data-api-base={apiBase}>
      <noscript>Для кабинета нужен JavaScript.</noscript>
    </div>
    <script is:inline type="module" src={jsUrl}></script>
  </body>
</html>
