---
import { site } from '../../content/site';
import styles from './Hero.module.css';
import { externalLink } from '../../lib/links';
import CodeTerminal from './CodeTerminal.astro';
---

<section class={styles.hero} id="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class={styles.tabs}>
      <span class={styles.active}><span aria-hidden="true"></span> profile.lua</span>
      <a href="#cases">work.md</a>
      <a href="#contact">contact.sh</a>
      <span class={styles.branch} aria-hidden="true"> main</span>
    </div>
    <div class={styles.workspace}>
      <div class={styles.copy}>
        <p class={styles.intro}><span class={styles.number} aria-hidden="true">01</span><span>Дмитрий Зверев <span class={styles.comment}>/ Python-разработчик</span></span></p>
        <h1 id="hero-title" class={styles.title}>
          <span>Сайты.</span>
          <span>Боты.</span>
          <span class={styles.accent}>Backend.</span>
        </h1>
        <p class={styles.description}>Помогаю запустить новый сервис или доработать существующий: от базы данных и API до интерфейса и запуска на сервере.</p>
        <p class={styles.experience}>Дмитрий Зверев — более 3 лет коммерческой разработки. Основная специализация — Python backend. Для полного продукта разрабатываю интерфейс на React и подключаю интеграции.</p>
        <ul class={styles.offer} aria-label="С чем могу помочь">
          <li><span>Сайты</span> Лендинги, веб-приложения и личные кабинеты</li>
          <li><span>Боты</span> Telegram и MAX: заявки и автоматизация</li>
          <li><span>Backend</span> API, базы данных и интеграции сервисов</li>
        </ul>
        <div class={styles.actions}>
          <a class="button button-primary" href={site.telegramUrl} {...externalLink}>Обсудить проект <svg class={styles.ctaArrow} aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" /></svg></a>
          <a class={styles.workLink} href="#cases">Смотреть проекты <span aria-hidden="true">↓</span></a>
        </div>
        <p class={styles.stack}>Python · FastAPI · Go · Rust · React · TypeScript · Docker</p>
      </div>
      <div class={styles.art}>
        <CodeTerminal />
      </div>
    </div>
    <div class={styles.status} aria-hidden="true"><span class={styles.mode}>NORMAL</span><span>profile.lua</span><span class={styles.statusRight}>От задачи до запуска</span></div>
    <form class={styles.command} action={site.telegramUrl} method="get" target="_blank" aria-label="Обсудить задачу в Telegram">
      <span class={styles.prompt} aria-hidden="true">:</span>
      <input
        class={styles.message}
        type="text"
        name="text"
        aria-label="Описание вашей задачи"
        placeholder="Коротко опишите задачу"
        maxlength="4000"
        autocomplete="off"
      />
      <button class={styles.send} type="submit">Написать в Telegram <span aria-hidden="true">↗</span></button>
    </form>
    <p class={styles.draftNote}>Текст откроется в Telegram как черновик — отправку подтверждаете вы.</p>
  </div>
</section>
