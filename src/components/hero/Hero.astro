---
import { site } from '../../content/site';
import styles from './Hero.module.css';
import { externalLink } from '../../lib/links';
import Arrow from '../site/Arrow.astro';
import CodeTerminal from './CodeTerminal.astro';
---

<section class={styles.hero} id="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class={styles.tabs}>
      <span class={styles.active}>profile.lua</span>
      <a href="#cases">work.md</a>
      <a href="#contact">contact.sh</a>
      <span class={styles.branch} aria-hidden="true"> main</span>
    </div>
    <div class={styles.workspace}>
      <div class={styles.copy}>
        <p class={styles.intro}><span class={styles.number} aria-hidden="true">01</span><span class={styles.identity}><span>Дмитрий Зверев</span><span class={styles.comment}>Python-разработчик</span></span></p>
        <h1 id="hero-title" class={styles.title}>
          <span>Сайты.</span>
          <span>Боты.</span>
          <span class={styles.accent}>Backend.</span>
        </h1>
        <p class={styles.description}>Сайты и личные кабинеты, Telegram/MAX-боты, API и интеграции — с нуля или в вашем проекте.</p>
        <p class={styles.experience}>Более 3 лет коммерческой разработки. Python backend, интерфейсы на React и запуск на сервере.</p>
        <div class={styles.actions}>
          <a class="button button-primary" href={site.telegramUrl} {...externalLink}>Обсудить проект <Arrow /></a>
          <a class={styles.workLink} href="#cases">Смотреть проекты <Arrow direction="down" /></a>
        </div>
        <p class={styles.stack} aria-label="Технологии">{['Python', 'FastAPI', 'Go', 'Rust', 'React', 'TypeScript', 'Docker'].map(item => <span>{item}</span>)}</p>
      </div>
      <div class={styles.art}>
        <CodeTerminal />
      </div>
    </div>
    <div class={styles.status} aria-hidden="true"><span class={styles.mode}>NORMAL</span><span>profile.lua</span><span class={styles.statusRight}>От задачи до запуска</span></div>
    <form class={styles.command} action={site.telegramUrl} method="get" target="_blank" aria-label="Обсудить задачу в Telegram">
      <span class={styles.prompt} aria-hidden="true">:</span>
      <input
        class={`${styles.message} ym-disable-keys`}
        type="text"
        name="text"
        aria-label="Описание вашей задачи"
        placeholder="Коротко опишите задачу"
        maxlength="4000"
        autocomplete="off"
      />
      <button class={styles.send} type="submit">Написать в Telegram <Arrow /></button>
    </form>
    <p class={styles.draftNote}>Откроется черновик в Telegram. Отправка — только по вашему подтверждению.</p>
  </div>
</section>
