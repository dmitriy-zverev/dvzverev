---
import { site } from '../../content/site';
import styles from './Header.module.css';
import { externalLink } from '../../lib/links';
import Arrow from './Arrow.astro';
---

<header class={styles.header}>
  <div class={`container ${styles.inner}`}>
    <a class={styles.brand} href="/" aria-label={`${site.fullName}, главная`}>
      <span class={styles.wordmark}>dvzverev<span class={styles.domain}>.ru</span></span>
    </a>
    <nav class={styles.nav} aria-label="Основная навигация">
      <a href="#cases"><span>01</span> Проекты</a>
      <a href="#contact"><span>02</span> Контакт</a>
    </nav>
    <div class={styles.actions}>
      <nav class={styles.mobileNav} aria-label="Быстрая навигация">
        <a href="#cases">Проекты</a>
        <a href="#contact">Контакт</a>
      </nav>
      <a class={styles.telegram} href={site.telegramUrl} aria-label="Написать в Telegram" {...externalLink}>
        <svg class={styles.telegramIcon} aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M21.7 3.3 18.4 20c-.3 1.2-.9 1.5-1.8.9l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.3-8.4c.4-.4-.1-.6-.6-.3L5.8 13.5.9 12c-1.1-.3-1.1-1.1.2-1.6L20.2 3c.9-.3 1.7.2 1.5.3Z" /></svg><span class={styles.telegramText}>telegram</span><Arrow />
      </a>
    </div>
  </div>
</header>
