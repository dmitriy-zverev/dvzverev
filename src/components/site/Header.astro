---
import { site } from '../../content/site';
import styles from './Header.module.css';
import { externalLink } from '../../lib/links';
---

<header class={styles.header}>
  <div class={`container ${styles.inner}`}>
    <a class={styles.brand} href="/" aria-label={`${site.fullName}, главная`}>
      <span class={styles.wordmark}>dvzverev<span class={styles.domain}>.ru</span></span>
    </a>
    <nav class={styles.nav} aria-label="Основная навигация">
      <a href="#cases"><span>01</span> Проекты</a>
      <a href="#contact"><span>02</span> Контакт</a>
    </nav>
    <div class={styles.actions}>
      <nav class={styles.mobileNav} aria-label="Быстрая навигация">
        <a href="#cases">Проекты</a>
        <a href="#contact">Контакт</a>
      </nav>
      <a class={styles.telegram} href={site.telegramUrl} {...externalLink}>
        <span aria-hidden="true"></span> telegram<span aria-hidden="true"></span>
      </a>
    </div>
  </div>
</header>
