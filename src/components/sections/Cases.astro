---
import { cases } from '../../content/cases';
import styles from './Cases.module.css';
import { externalLink } from '../../lib/links';
import Arrow from '../site/Arrow.astro';
import { formatWorkTree, siteHostname } from '../../lib/siteHost';

const workTree = formatWorkTree(cases);
---

<section class={`section ${styles.section}`} id="cases" aria-labelledby="cases-title">
  <div class="container">
    <div class={styles.heading}>
      <div>
        <p class="section-label">Избранные работы / work.md</p>
        <h2 class={`section-title ${styles.title}`} id="cases-title">Проекты.<br /> По делу.</h2>
        <p class={styles.lede}>Коммерческий проект и три собственных продукта.<br />Откройте проект, чтобы посмотреть задачу и реализацию.</p>
      </div>
      <pre class={styles.tree} aria-hidden="true">{workTree}</pre>
    </div>

    <div class={styles.list}>
      {cases.map((item, index) => (
        <details class={styles.case} open={index === 0}>
          <summary>
            <span class={styles.index}>{String(index + 1).padStart(2, '0')}</span>
            <div class={styles.summaryMain}>
              <span class={styles.name}>{item.name}</span>
              <span class={styles.kind}>{item.isCommercial ? 'Коммерческий проект' : 'Собственный проект'}</span>
              <span class={styles.headline}>{item.headline}</span>
            </div>
            <span class={styles.siteHint}>{siteHostname(item.siteUrl)}</span>
            <span class={styles.toggle} aria-hidden="true"></span>
          </summary>
          <div class={styles.body}>
            <dl class={styles.meta}>
              <div>
                <dt>Задача</dt>
                <dd>{item.problem}</dd>
              </div>
              {item.role && <div>
                <dt>Моя роль</dt>
                <dd>{item.role}</dd>
              </div>}
              <div>
                <dt>Реализация</dt>
                <dd>{item.solution}</dd>
              </div>
              <div>
                <dt>Что делает</dt>
                <dd>{item.result}</dd>
              </div>
              <div>
                <dt>Сайт</dt>
                <dd>
                  <a href={item.siteUrl} {...externalLink}>
                    {siteHostname(item.siteUrl)}<Arrow />
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
