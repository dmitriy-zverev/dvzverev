---
import { site } from '../../content/site';
import styles from './Contact.module.css';
import { externalLink } from '../../lib/links';
import Arrow from '../site/Arrow.astro';
---

<section class={`section ${styles.contact}`} id="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="section-label">Обсудим вашу задачу / contact.sh</p>
    <div class={styles.layout}>
      <header class={styles.header}>
        <h2 class={`section-title ${styles.title}`} id="contact-title">
          {site.contactHeadline}<br /><span class={styles.accent}>{site.contactAccent}</span>
        </h2>
        <p class={styles.lede}>{site.contactSubline}</p>
        <p class={styles.startNote}>Можно без готового ТЗ. Расскажите, что хотите сделать, что уже есть и когда нужен результат.</p>
      </header>

      <aside class={styles.aside} aria-label="Контакты">
        <a class={styles.cta} href={site.telegramUrl} {...externalLink}>
          <div class={styles.ctaMain}>
            <span class={styles.ctaLabel}>Telegram</span>
            <span class={styles.ctaValue}>@zverev_dmitry</span>
            <Arrow />
          </div>
          <p class={styles.ctaNote}>Обсудить проект напрямую со мной</p>
        </a>
        <a class={styles.email} href={`mailto:${site.email}`}><span>EMAIL</span><span>{site.email}</span><Arrow /></a>

        <ul class={styles.facts}>
          <li>Москва / remote</li>
          <li>
            <a href={site.githubUrl} {...externalLink}>GitHub <Arrow /></a>
          </li>
        </ul>
      </aside>
    </div>
    <ol class={styles.steps} aria-label="Как проходит работа">
      <li><strong>Разбираем задачу</strong><span>Что нужно пользователям, что уже есть и какой результат нужен бизнесу.</span></li>
      <li><strong>Согласуем первый этап</strong><span>Объём, стоимость, сроки и критерии готовности — до начала разработки.</span></li>
      <li><strong>Разрабатываем и запускаем</strong><span>Показываю результат по ходу работы. Поддержку и следующие этапы обсуждаем отдельно.</span></li>
    </ol>
    <details class={styles.terms}>
      <summary><span>Условия работы</span><span class={styles.termsHint}>Оценка · оплата · код · поддержка</span><span class={styles.termsToggle} aria-hidden="true"></span></summary>
      <dl>
        <div><dt>Оценка</dt><dd>После обсуждения задачи фиксируем объём, стоимость, сроки и критерии приёмки в договорённостях по проекту.</dd></div>
        <div><dt>Оплата</dt><dd>По этапам: аванс перед началом этапа, остаток после его приёмки. Размер аванса согласуем до старта.</dd></div>
        <div><dt>Передача</dt><dd>Исходный код и инструкция по запуску — после оплаты согласованного объёма. Права на результат и сторонние лицензии фиксируем отдельно.</dd></div>
        <div><dt>После запуска</dt><dd>Период исправления ошибок согласуем до начала работ. Новые функции, сопровождение и расходы на сервер или AI-сервисы — отдельно.</dd></div>
      </dl>
    </details>
  </div>
</section>
