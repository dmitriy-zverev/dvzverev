---
import { site } from '../../content/site';
import styles from './About.module.css';
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <p class="section-label">Scene 06</p>
    <div class={styles.grid}>
      <div>
        <h2 class="section-title" id="about-title">Подход и принципы</h2>
        <ul class={styles['stack-list']}>
          {site.principles.map((principle) => (
            <li>{principle}</li>
          ))}
        </ul>

        <h3 class="section-label" style="margin-top: 2rem;">Стек по ролям</h3>
        <dl class={styles['stack-groups']}>
          {site.stackGroups.map((group) => (
            <div class={styles['stack-row']}>
              <dt>{group.role}</dt>
              <dd>{group.items}</dd>
            </div>
          ))}
        </dl>
      </div>

      <article class={styles['about-card']}>
        <div class={styles['photo-placeholder']} aria-hidden="true">
          фото скоро
        </div>
        <h3>{site.fullName}</h3>
        <p>{site.aboutBio}</p>
      </article>
    </div>
  </div>
</section>
